{
  "name": "mxbox-build-tools",
  "version": "1.0.0",
  "description": "MXbox APK 一键打包工具（Node.js 版，带进度条）",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build_apk.js",
    "build:tv64": "node build_apk.js leanback arm64_v8a",
    "build:tv32": "node build_apk.js leanback armeabi_v7a",
    "build:tv": "node build_apk.js leanback all",
    "build:mobile64": "node build_apk.js mobile arm64_v8a",
    "build:mobile32": "node build_apk.js mobile armeabi_v7a",
    "build:mobile": "node build_apk.js mobile all",
    "build:all": "node build_apk.js all all"
  }
}
